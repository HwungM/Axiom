# Optional. Public Solana RPC works for light collection but will rate-limit.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
# Required only for the OQCA forward paper process. A free Helius RPC URL is
# sufficient for development; this endpoint must support getTokenLargestAccounts.
OWNERSHIP_RPC_URL=
PAPER_CONFIG=config/paper.v4.json

# GeckoTerminal asks that unauthenticated requests remain low-frequency.
GECKO_PAGES=3
GECKO_PAGE_PAUSE_MS=7000

# One forward snapshot per minute by default.
POLL_INTERVAL_MS=60000

# Discord webhooks are credentials. Keep them only in .env and never commit them.
DISCORD_WEBHOOK_BOT_STATUS=
DISCORD_WEBHOOK_MIGRATION_FEED=
DISCORD_WEBHOOK_DECISION_LOG=
DISCORD_WEBHOOK_PAPER_TRADES=
DISCORD_WEBHOOK_ALERTS=
DISCORD_WEBHOOK_DAILY_REPORTS=
DISCORD_WEBHOOK_CASE_STUDIES=
DISCORD_WEBHOOK_PNL=
