# Optional. Public Solana RPC works for light collection but will rate-limit.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# GeckoTerminal asks that unauthenticated requests remain low-frequency.
GECKO_PAGES=3
GECKO_PAGE_PAUSE_MS=7000

# One forward snapshot per minute by default.
POLL_INTERVAL_MS=60000

