{
  "version": "paper-v3.1-latency-competition-guard",
  "dataDirectory": "paper-v3-1",
  "enabled": true,
  "frozen": true,
  "startingBankrollSol": 3,
  "positionSizeSol": 0.5,
  "shadowPositionSizesSol": [1, 1.5, 2],
  "shadowComparison": {
    "minimumCompletedTrades": 50,
    "targetCompletedTrades": 100,
    "mode": "matched-signals-authoritative-state"
  },
  "maxConcurrentPositions": 3,
  "observationWindowSeconds": 1,
  "takeProfitPct": 50,
  "stopLossPct": 20,
